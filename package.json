{
  "name": "carecircle",
  "version": "0.1.0",
  "description": "An Alexa+ MCP server that keeps an aging parent and their family in the loop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "check": "tsx --env-file-if-exists=.env src/check.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "aws:local": "tsx --env-file-if-exists=.env src/local-aws.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@aws-sdk/client-sns": "^3.1150.0",
    "@aws-sdk/lib-dynamodb": "^3.1150.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "dynalite": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
