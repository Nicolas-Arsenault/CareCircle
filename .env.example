# Copy to .env and adjust. Everything has a working local default.
PORT=3000
HOST=127.0.0.1
PARENT_NAME=Mom
CARE_TIMEZONE=America/Toronto
CHECKIN_DEADLINE=10:00
DOSE_GRACE_MINUTES=60
ALERT_CHECK_MINUTES=5

# Storage: file (default, data/carecircle.json), memory, or dynamodb
STORE=file
DATA_FILE=data/carecircle.json
# TABLE_NAME=CareCircle

# Summaries: template (default, no AI) or bedrock
SUMMARIZER=template
# How the simulated Alexa understands speech: rules (default, offline) or bedrock
ALEXA_BRAIN=rules
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# AWS_REGION=us-east-1

# Family alerts: console (default) or sns
NOTIFIER=console
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:CareCircle-FamilyAlerts

# Optional shared secret for /mcp (send "Authorization: Bearer <token>")
# MCP_AUTH_TOKEN=
